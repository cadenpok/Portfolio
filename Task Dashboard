    st.markdown('<div class="page-title">Log New Task</div>', unsafe_allow_html=True)
    CATEGORIES = get_categories()
    PRIORITIES = get_priorities()

    with st.form("add_task_form", clear_on_submit=True):
        c1, c2 = st.columns(2)
        with c1:
            task_name = st.text_input("Task Description *", placeholder="e.g. Prepare Q2 review for Harrington Family")
            category  = st.selectbox("Category *", CATEGORIES)
            priority  = st.select_slider("Priority *", options=PRIORITIES,
                                         value=PRIORITIES[len(PRIORITIES)//2] if PRIORITIES else "Medium")
            client    = st.selectbox("Linked Client", get_clients())
            status    = st.selectbox("Initial Status", ["Open","In Progress","Waiting"])

        with c2:
            dl_date  = st.date_input("Deadline Date *", value=date.today() + timedelta(days=3), min_value=date.today())
            has_time = st.checkbox("Set a specific deadline time")
            if has_time:
                dl_time     = st.time_input("Deadline Time", value=time(9, 0))
                dl_time_str = dl_time.strftime("%H:%M")
            else:
                dl_time_str = ""

            st.markdown("**🔔 Reminder**")
            reminder_choice = st.selectbox("Quick reminder", list(REMINDER_OPTIONS.keys()))
            use_custom_rem  = st.checkbox("Or set a custom reminder date/time")
            if use_custom_rem:
                cr1, cr2    = st.columns(2)
                custom_date = cr1.date_input("Reminder Date", value=dl_date - timedelta(days=1))
                custom_time = cr2.time_input("Reminder Time", value=time(9, 0))
                reminder_dt = datetime.combine(custom_date, custom_time).strftime("%Y-%m-%d %H:%M")
            else:
                reminder_dt = compute_reminder_dt(dl_date, dl_time_str, REMINDER_OPTIONS.get(reminder_choice, ""))

        notes     = st.text_area("Notes / Context", placeholder="Any relevant details, instructions, or dependencies…", height=90)
        submitted = st.form_submit_button("⚡ Log Task", use_container_width=True)

        if submitted:
            if not task_name.strip():
                st.error("Task description is required.")
            else:
                client_val = "" if client == "— None —" else client
                conn = get_conn()
                conn.execute("""
                    INSERT INTO tasks (category, task_name, priority, deadline_date, deadline_time,
                                       reminder_datetime, client, status, notes)
                    VALUES (?,?,?,?,?,?,?,?,?)
                """, (category, task_name.strip(), priority, dl_date.isoformat(),
                      dl_time_str, reminder_dt, client_val, status, notes.strip()))
                conn.commit(); conn.close()
                st.success(
                    f"✅ **{task_name}** logged · {priority} · Due {dl_date.strftime('%b %d')}" +
                    (f" @ {dl_time_str}" if dl_time_str else "") +
                    (f" · 🔔 Reminder: {reminder_dt}" if reminder_dt else "")
                )

