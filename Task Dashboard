elif page == "✏️ Edit Task":
    st.markdown('<div class="page-title">Edit Task</div>', unsafe_allow_html=True)
    CATEGORIES = get_categories()
    PRIORITIES = get_priorities()

    conn      = get_conn()
    all_tasks = pd.read_sql_query("SELECT id, task_name, status, priority FROM tasks ORDER BY id DESC", conn)
    conn.close()

    if all_tasks.empty:
        st.info("No tasks yet.")
    else:
        task_options   = {f"#{r['id']} — {r['task_name']} [{r['status']}]": r["id"] for _, r in all_tasks.iterrows()}
        selected_label = st.selectbox("Select task to edit", list(task_options.keys()))
        task_id        = task_options[selected_label]

        conn = get_conn()
        row  = dict(conn.execute("SELECT * FROM tasks WHERE id=?", (task_id,)).fetchone())
        conn.close()

        with st.form("edit_form"):
            c1, c2 = st.columns(2)
            new_name     = c1.text_input("Task Description", value=row["task_name"])
            new_category = c1.selectbox("Category", CATEGORIES,
                           index=CATEGORIES.index(row["category"]) if row["category"] in CATEGORIES else 0)
            new_priority = c1.select_slider("Priority", PRIORITIES,
                           value=row["priority"] if row["priority"] in PRIORITIES else PRIORITIES[0])
            clients_list = get_clients()
            client_idx   = clients_list.index(row["client"]) if row.get("client") and row["client"] in clients_list else 0
            new_client   = c1.selectbox("Linked Client", clients_list, index=client_idx)
            new_status   = c1.selectbox("Status", STATUSES,
                           index=STATUSES.index(row["status"]) if row["status"] in STATUSES else 0)

            new_deadline = c2.date_input("Deadline Date", value=pd.to_datetime(row["deadline_date"]).date())
            existing_time = row.get("deadline_time","")
            has_time     = c2.checkbox("Has specific time", value=bool(existing_time))
            if has_time:
                try:    t_val = datetime.strptime(existing_time, "%H:%M").time()
                except: t_val = time(9, 0)
                new_time_str = c2.time_input("Deadline Time", value=t_val).strftime("%H:%M")
            else:
                new_time_str = ""

            st.markdown("**🔔 Reminder**")
            existing_rem  = row.get("reminder_datetime","")
            use_custom_rem= st.checkbox("Set custom reminder", value=bool(existing_rem))
            rm1, rm2      = st.columns(2)
            if use_custom_rem:
                try:    rem_def = datetime.strptime(existing_rem, "%Y-%m-%d %H:%M")
                except: rem_def = datetime.now() + timedelta(hours=1)
                rem_date    = rm1.date_input("Reminder Date", value=rem_def.date())
                rem_t       = rm2.time_input("Reminder Time", value=rem_def.time())
                new_rem_str = datetime.combine(rem_date, rem_t).strftime("%Y-%m-%d %H:%M")
            else:
                quick_rem   = rm1.selectbox("Quick remind", list(REMINDER_OPTIONS.keys()))
                new_rem_str = compute_reminder_dt(new_deadline, new_time_str, REMINDER_OPTIONS.get(quick_rem,""))

            new_notes = st.text_area("Notes", value=row.get("notes",""), height=100)

            if st.form_submit_button("💾 Save Changes", use_container_width=True):
                client_val = "" if new_client == "— None —" else new_client
                conn = get_conn()
                conn.execute("""
                    UPDATE tasks SET task_name=?, category=?, priority=?, deadline_date=?,
                    deadline_time=?, reminder_datetime=?, client=?, status=?, notes=?,
                    completed_at = CASE WHEN ? = 'Completed' AND status != 'Completed'
                                        THEN CURRENT_TIMESTAMP ELSE completed_at END
                    WHERE id=?
                """, (new_name, new_category, new_priority, new_deadline.isoformat(),
                      new_time_str, new_rem_str, client_val, new_status, new_notes, new_status, task_id))
                conn.commit(); conn.close()
                st.success("Task updated."); st.rerun()

        st.markdown("---")
        if st.button("🗑️ Delete this task permanently"):
            conn = get_conn()
            conn.execute("DELETE FROM tasks WHERE id=?", (task_id,))
            conn.commit(); conn.close()
            st.warning("Task deleted."); st.rerun()

