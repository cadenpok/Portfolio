#  PAGE: ANALYTICS
# ─────────────────────────────────────────────
elif page == "📈 Analytics":
    st.markdown('<div class="page-title">Analytics</div>', unsafe_allow_html=True)
    df = load_tasks()

    if df.empty:
        st.info("No task data yet.")
    else:
        df["deadline_date"] = pd.to_datetime(df["deadline_date"])
        df["created_at"]    = pd.to_datetime(df["created_at"])

        r1, r2 = st.columns(2)
        sc      = df.groupby("status").size().reset_index(name="count")
        fig_pie = px.pie(sc, names="status", values="count", color="status",
                         color_discrete_map=STATUS_COLORS, hole=0.45,
                         template="plotly_dark", title="Tasks by Status")
        fig_pie.update_layout(paper_bgcolor="#161b22", font=dict(color="#c9d1d9"))
        r1.plotly_chart(fig_pie, use_container_width=True)

        pc      = df.groupby("priority").size().reset_index(name="count")
        fig_pri = px.bar(pc, x="priority", y="count", color="priority",
                         color_discrete_map=PRIORITY_COLORS, template="plotly_dark", title="Tasks by Priority")
        fig_pri.update_layout(paper_bgcolor="#161b22", plot_bgcolor="#161b22",
                              showlegend=False, font=dict(color="#c9d1d9"))
        r2.plotly_chart(fig_pri, use_container_width=True)

        done = df[df["status"]=="Completed"].copy()
        if not done.empty:
            done["week"] = done["created_at"].dt.to_period("W").apply(lambda r: r.start_time)
            w = done.groupby("week").size().reset_index(name="completed")
            fig_l = px.line(w, x="week", y="completed", markers=True,
                            template="plotly_dark", title="Completed Over Time",
                            color_discrete_sequence=["#58a6ff"])
            fig_l.update_layout(paper_bgcolor="#161b22", plot_bgcolor="#161b22", font=dict(color="#c9d1d9"))
            st.plotly_chart(fig_l, use_container_width=True)

        overdue_df = df[df["status"].isin(["Open","In Progress","Waiting"]) &
                        (df["deadline_date"].dt.date < date.today())]
        if not overdue_df.empty:
            oc     = overdue_df.groupby("category").size().reset_index(name="count")
            fig_od = px.bar(oc, x="category", y="count", template="plotly_dark",
                            title="⚠️ Overdue by Category", color_discrete_sequence=["#ef4444"])
            fig_od.update_layout(paper_bgcolor="#161b22", plot_bgcolor="#161b22",
                                 showlegend=False, font=dict(color="#c9d1d9"))
            st.plotly_chart(fig_od, use_container_width=True)

        st.markdown('<div class="section-header">Export</div>', unsafe_allow_html=True)
        st.download_button("⬇️ Export to CSV", df.to_csv(index=False).encode("utf-8"),
                           "tasks_export.csv", "text/csv")

