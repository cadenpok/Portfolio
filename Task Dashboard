elif page == "👥 Clients":
    st.markdown('<div class="page-title">Client Roster</div>', unsafe_allow_html=True)

    conn       = get_conn()
    clients_df = pd.read_sql_query("SELECT * FROM clients ORDER BY name", conn)

    if clients_df.empty:
        st.info("No clients yet. Add one below.")
    else:
        for _, c in clients_df.iterrows():
            header = f"👤  {c['name']}" + (f"  ·  {c['company']}" if c.get("company") else "")
            with st.expander(header, expanded=False):
                with st.form(f"edit_client_{c['id']}"):
                    ec1, ec2 = st.columns(2)
                    new_name    = ec1.text_input("Name *",           value=c["name"])
                    new_company = ec1.text_input("Company / Entity", value=c.get("company",""))
                    new_advisor = ec1.text_input("Advisor",          value=c.get("advisor",""))
                    new_phone   = ec2.text_input("Phone",            value=c.get("phone",""))
                    new_email   = ec2.text_input("Email",            value=c.get("email",""))
                    new_notes   = st.text_area("Notes",              value=c.get("notes",""), height=80)

                    s1, s2 = st.columns(2)
                    save_c = s1.form_submit_button("💾 Save Changes",        use_container_width=True)
                    del_c  = s2.form_submit_button("🗑️ Delete Client",       use_container_width=True)

                    if save_c:
                        if not new_name.strip():
                            st.error("Name is required.")
                        else:
                            conn.execute("""UPDATE clients SET name=?,company=?,advisor=?,phone=?,email=?,notes=?
                                           WHERE id=?""",
                                         (new_name.strip(), new_company, new_advisor, new_phone, new_email, new_notes, c["id"]))
                            conn.commit(); st.success("Client updated."); st.rerun()

                    if del_c:
                        conn.execute("DELETE FROM clients WHERE id=?", (c["id"],))
                        conn.commit(); st.warning(f"Client '{c['name']}' deleted."); st.rerun()

                # Linked open tasks
                linked = pd.read_sql_query(
                    "SELECT task_name, priority, status, deadline_date FROM tasks WHERE client=? AND status NOT IN ('Completed','Cancelled') ORDER BY deadline_date",
                    conn, params=(c["name"],)
                )
                if not linked.empty:
                    st.markdown(f'<div style="font-size:.8rem;color:#6e7681;margin-top:10px;margin-bottom:4px">{len(linked)} open task{"s" if len(linked)>1 else ""}</div>', unsafe_allow_html=True)
                    for _, t in linked.iterrows():
                        st.markdown(f'<div style="font-size:.82rem;color:#c9d1d9;padding:3px 0">→ {t["task_name"]} &nbsp; {priority_badge(t["priority"])} &nbsp; <span style="color:#6e7681">{t["deadline_date"]}</span></div>', unsafe_allow_html=True)

    st.markdown('<div class="section-header">Add New Client</div>', unsafe_allow_html=True)
    with st.form("add_client"):
        nc1, nc2 = st.columns(2)
        add_name    = nc1.text_input("Name *")
        add_company = nc1.text_input("Company / Entity")
        add_advisor = nc1.text_input("Advisor", value="You")
        add_phone   = nc2.text_input("Phone")
        add_email   = nc2.text_input("Email")
        add_notes   = st.text_area("Notes", height=70)

        if st.form_submit_button("➕ Add Client", use_container_width=True):
            if add_name.strip():
                try:
                    conn.execute("INSERT INTO clients (name,company,advisor,phone,email,notes) VALUES (?,?,?,?,?,?)",
                                 (add_name.strip(), add_company, add_advisor, add_phone, add_email, add_notes))
                    conn.commit(); st.success(f"Client **{add_name}** added."); st.rerun()
                except Exception:
                    st.error("A client with that name already exists.")
            else:
                st.error("Name is required.")
    conn.close()

