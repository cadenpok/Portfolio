        except: cats_default = "General"
        cats_text = st.text_area("Task Categories (one per line)", value=cats_default, height=200)
    with t2:
        try:    pris_default = "\n".join(json.loads(get_setting("priority_levels")))
        except: pris_default = "Low\nMedium\nHigh\nCritical"
