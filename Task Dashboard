DB = "wealth_tasks.db"

def get_conn():
    conn = sqlite3.connect(DB, check_same_thread=False)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    conn = get_conn()
    conn.executescript("""
        CREATE TABLE IF NOT EXISTS tasks (
            id                INTEGER PRIMARY KEY AUTOINCREMENT,
            category          TEXT    NOT NULL,
            task_name         TEXT    NOT NULL,
            priority          TEXT    NOT NULL,
            deadline_date     DATE    NOT NULL,
            deadline_time     TEXT    DEFAULT '',
            reminder_datetime TEXT    DEFAULT '',
            client            TEXT    DEFAULT '',
            status            TEXT    DEFAULT 'Open',
            notes             TEXT    DEFAULT '',
            created_at        DATETIME DEFAULT CURRENT_TIMESTAMP,
            completed_at      DATETIME
        );
        CREATE TABLE IF NOT EXISTS clients (
            id        INTEGER PRIMARY KEY AUTOINCREMENT,
            name      TEXT NOT NULL UNIQUE,
            phone     TEXT DEFAULT '',
            email     TEXT DEFAULT '',
            company   TEXT DEFAULT '',
            advisor   TEXT DEFAULT '',
            notes     TEXT DEFAULT ''
        );
        CREATE TABLE IF NOT EXISTS settings (
            key   TEXT PRIMARY KEY,
            value TEXT
        );
    """)

    # Migrate old schemas gracefully

    # Rename old 'deadline' column to 'deadline_date' if needed
    cols = [r[1] for r in conn.execute("PRAGMA table_info(tasks)").fetchall()]
    if "deadline" in cols and "deadline_date" not in cols:
        conn.executescript("""
            ALTER TABLE tasks RENAME TO tasks_old;
            CREATE TABLE tasks (
                id                INTEGER PRIMARY KEY AUTOINCREMENT,
                category          TEXT    NOT NULL,
                task_name         TEXT    NOT NULL,
                priority          TEXT    NOT NULL,
                deadline_date     DATE    NOT NULL,
                deadline_time     TEXT    DEFAULT '',
                reminder_datetime TEXT    DEFAULT '',
                client            TEXT    DEFAULT '',
                status            TEXT    DEFAULT 'Open',
                notes             TEXT    DEFAULT '',
                created_at        DATETIME DEFAULT CURRENT_TIMESTAMP,
                completed_at      DATETIME
            );
            INSERT INTO tasks (id, category, task_name, priority, deadline_date, status, notes, created_at, completed_at)
            SELECT id, category, task_name, priority, deadline, status, notes, created_at, completed_at
            FROM tasks_old;
            DROP TABLE tasks_old;
        """)

    migrations_tasks = [
        ("deadline_time",     "''"),
        ("reminder_datetime", "''"),
        ("client",            "''"),
    ]
    for col, default in migrations_tasks:
        try:
            conn.execute(f"ALTER TABLE tasks ADD COLUMN {col} TEXT DEFAULT {default}")
        except Exception:
            pass

    migrations_clients = [
        ("phone",   "''"),
        ("email",   "''"),
        ("company", "''"),
        ("notes",   "''"),
    ]
    for col, default in migrations_clients:
        try:
            conn.execute(f"ALTER TABLE clients ADD COLUMN {col} TEXT DEFAULT {default}")
        except Exception:
            pass

    # Seed demo clients
    if conn.execute("SELECT COUNT(*) FROM clients").fetchone()[0] == 0:
        demo = [
            ("Harrington Family",  "312-555-0181", "harrington@email.com",  "Harrington Holdings LLC",  "You", "Prefers morning calls. Birthday in March."),
            ("Westbrook Trust",    "312-555-0294", "trust@westbrook.com",   "Westbrook Family Office",  "You", "Quarterly reviews only. Contact: Margaret."),
            ("Okafor & Associates","312-555-0347", "okafor@assoc.com",      "Okafor & Associates CPAs", "You", "Tax-sensitive. CC CPA on all correspondence."),
            ("Rivera Retirement",  "312-555-0412", "jrivera@email.com",     "",                         "You", "Recently widowed. Very hands-on client."),
        ]
        conn.executemany("INSERT INTO clients (name,phone,email,company,advisor,notes) VALUES (?,?,?,?,?,?)", demo)

    # Seed default settings
    defaults = {
        "dash_show_overdue":     "true",
        "dash_show_today":       "true",
        "dash_show_reminders":   "true",
        "dash_urgency_days":     "3",
        "dash_max_cards":        "8",
        "dash_show_chart":       "true",
        "dash_metric_open":      "true",
        "dash_metric_critical":  "true",
        "dash_metric_overdue":   "true",
        "dash_metric_closed":    "true",
        "dash_metric_reminders": "true",
        "task_categories":       json.dumps(["Proposal","Client Call","Service Request","Tax Documents","Compliance","Portfolio Review","General"]),
        "priority_levels":       json.dumps(["Low","Medium","High","Critical"]),
    }
    for k, v in defaults.items():
        conn.execute("INSERT OR IGNORE INTO settings (key,value) VALUES (?,?)", (k, v))

    conn.commit()
    conn.close()

