def days_label(d: date) -> str:
    diff = (d - date.today()).days
    if diff < 0:  return f"⚠️ {abs(diff)}d overdue"
    if diff == 0: return "🔴 Due today"
    if diff == 1: return "🟠 Due tomorrow"
    if diff <= 7: return f"🟡 {diff}d left"
    return f"🟢 {diff}d left"

def priority_badge(p):
    c = PRIORITY_COLORS.get(p, "#888")
    return f'<span style="background:{c};color:#fff;padding:2px 10px;border-radius:20px;font-size:12px;font-weight:700">{p}</span>'

def status_badge(s):
    c = STATUS_COLORS.get(s, "#888")
    return f'<span style="background:{c};color:#fff;padding:2px 10px;border-radius:20px;font-size:12px;font-weight:700">{s}</span>'

def compute_reminder_dt(deadline_date, deadline_time_str, offset_code):
    if not offset_code:
        return ""
    try:
        if deadline_time_str:
            h, m    = map(int, deadline_time_str.split(":"))
            base_dt = datetime.combine(deadline_date, time(h, m))
        else:
            base_dt = datetime.combine(deadline_date, time(9, 0))
        offsets = {
            "at": timedelta(0), "15m": timedelta(minutes=15), "30m": timedelta(minutes=30),
            "1h": timedelta(hours=1),  "2h": timedelta(hours=2),
            "1d": timedelta(days=1),   "2d": timedelta(days=2),
        }
        return (base_dt - offsets.get(offset_code, timedelta(0))).strftime("%Y-%m-%d %H:%M")
    except Exception:
        return ""

def get_clients():
    conn = get_conn()
    rows = conn.execute("SELECT name FROM clients ORDER BY name").fetchall()
    conn.close()
    return ["— None —"] + [r[0] for r in rows]

def load_tasks(status_filter=None, category_filter=None, priority_filter=None, search=""):
    conn = get_conn()
    q    = "SELECT * FROM tasks WHERE 1=1"
    p    = []
    if status_filter and status_filter != "All":
        q += " AND status=?"; p.append(status_filter)
    if category_filter and category_filter != "All":
        q += " AND category=?"; p.append(category_filter)
    if priority_filter and priority_filter != "All":
        q += " AND priority=?"; p.append(priority_filter)
    if search:
        q += " AND (task_name LIKE ? OR notes LIKE ? OR client LIKE ?)"; p += [f"%{search}%"]*3
    priorities = get_priorities()
    pri_order  = " ".join([f"WHEN '{pr}' THEN {i}" for i, pr in enumerate(reversed(priorities))])
    q += f" ORDER BY CASE priority {pri_order} ELSE 99 END, deadline_date ASC"
    df = pd.read_sql_query(q, conn, params=p)
    conn.close()
    return df

def get_upcoming_reminders(hours_ahead=2):
    conn = get_conn()
    now  = datetime.now()
    soon = now + timedelta(hours=hours_ahead)
    rows = conn.execute("""
        SELECT id, task_name, priority, reminder_datetime, deadline_date, client
        FROM tasks
        WHERE status NOT IN ('Completed','Cancelled')
          AND reminder_datetime != ''
          AND reminder_datetime <= ?
        ORDER BY reminder_datetime ASC
    """, (soon.strftime("%Y-%m-%d %H:%M"),)).fetchall()
    conn.close()
    return [dict(r) for r in rows]

