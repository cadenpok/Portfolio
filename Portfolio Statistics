def process_account(name, portfolio, prices, meta):
    shares = pd.Series(portfolio)
    daily_val = (prices[shares.index] * shares).sum(axis=1)
    returns = daily_val.pct_change().dropna()
    
    # Weights for fundamentals
    current_val = (prices[shares.index].iloc[-1] * shares)
    weights = current_val / current_val.sum()
    
    avg_beta = (meta.loc[shares.index, 'Beta'] * weights).sum()
    avg_pe = (meta.loc[shares.index, 'PE'] * weights).dropna().sum()
    
    # Sharpe (Risk Free Rate assumed 4%)
    sharpe = (returns.mean() * 252 - 0.04) / (returns.std() * np.sqrt(252))
    
    # Drawdown
    cum_rets = (1 + returns).cumprod()
    peak = cum_rets.cummax()
    dd = (cum_rets - peak) / peak
    
    return {
        'name': name, 'daily_val': daily_val, 'returns': returns, 
        'beta': avg_beta, 'pe': avg_pe, 'sharpe': sharpe, 'dd': dd, 'total': daily_val.iloc[-1]
    }

