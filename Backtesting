def iplot_01_equity(pf, trades_df, m):
    done = _active(trades_df)
    ret  = pf["returns"]
    cum  = (1 + ret).cumprod()
    dd   = (cum - cum.cummax()) / cum.cummax() * 100

    fig = make_subplots(
        rows=3, cols=1, shared_xaxes=True,
        subplot_titles=["Portfolio Value ($)", "Drawdown (%)", "VIX"],
        row_heights=[0.55, 0.25, 0.20], vertical_spacing=0.04)

    fig.add_trace(go.Scatter(
        x=pf.index, y=pf["total_value"], name="Put Spread Strategy",
        line=dict(color=C["port"], width=2.2),
        hovertemplate="$%{y:,.0f}<extra>Strategy</extra>"), row=1, col=1)
    fig.add_trace(go.Scatter(
        x=pf.index, y=pf["bah_value"], name="SPY Buy & Hold",
        line=dict(color=C["spy"], width=1.5),
        hovertemplate="$%{y:,.0f}<extra>SPY B&H</extra>"), row=1, col=1)

    wins = done[done["total_pnl"] >= 0]
    lsss = done[done["total_pnl"] <  0]
    fig.add_trace(go.Scatter(
        x=wins["exit_date"], y=pf["total_value"].reindex(wins["exit_date"]).values,
        mode="markers", name="Win Exit",
        marker=dict(color=C["win"], size=7, symbol="triangle-up"),
        customdata=wins["total_pnl"].values,
        hovertemplate="Win: $%{customdata:,.0f}<extra></extra>"), row=1, col=1)
    fig.add_trace(go.Scatter(
        x=lsss["exit_date"], y=pf["total_value"].reindex(lsss["exit_date"]).values,
        mode="markers", name="Loss / Stop Exit",
        marker=dict(color=C["loss"], size=7, symbol="triangle-down"),
        customdata=lsss[["total_pnl", "exit_reason"]].values,
        hovertemplate="Loss: $%{customdata[0]:,.0f} (%{customdata[1]})<extra></extra>"),
        row=1, col=1)

    fig.add_trace(go.Scatter(
        x=dd.index, y=dd.values, name="Drawdown",
        fill="tozeroy", fillcolor="rgba(231,76,60,0.25)",
        line=dict(color=C["loss"], width=1)), row=2, col=1)

    fig.add_trace(go.Scatter(
        x=pf.index, y=pf["vix"], name="VIX",
        fill="tozeroy", fillcolor="rgba(149,165,166,0.12)",
        line=dict(color=C["vix"], width=1)), row=3, col=1)

    fig.add_hline(y=MIN_VIX, row=3, col=1, line_dash="dash", line_color="orange",
                  annotation_text=f"Min VIX {MIN_VIX}")

    fig.update_layout(
        title=(f"SPY Put Spread — Interactive Equity Curve  "
               f"│  CAGR {m['cagr']:.2%}  │  Sharpe {m['sharpe']:.2f}  │  "
               f"Max DD {m['max_drawdown']:.2%}"),
        height=900, hovermode="x unified")
    _showly(fig, "i01_equity_curve.html")


