    spy_gain = pf["spy_value"] - init_spy
    opt_gain = pf["cash"] - INITIAL_CASH
    ax.stackplot(pf.index,
                 [spy_gain.clip(lower=0), opt_gain.clip(lower=0)],
                 labels=["SPY Price Gain", "Options Premium Gain"],
                 colors=[C["spy"], C["win"]], alpha=0.75)
    ax.stackplot(pf.index,
                 [spy_gain.clip(upper=0), opt_gain.clip(upper=0)],
                 colors=[C["spy"], C["loss"]], alpha=0.4)
    ax.set_title("Gain Attribution — SPY vs Options Premium")
    ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda v, _: f"${v:,.0f}"))
    ax.legend(fontsize=8, loc="upper left"); ax.grid(True)

    # 3: SPY vs Strategy 12M return
    ax = axes[1, 0]
    ax.plot(strat_12m.index, strat_12m * 100, color=C["port"], lw=1.8, label="Strategy")
    ax.plot(bah_12m.index,   bah_12m   * 100, color=C["spy"],  lw=1.4, alpha=0.75,
            label="SPY B&H")
    ax.axhline(0, color=C["border"], lw=0.6, ls="--")
    ax.set_ylabel("Rolling 12M Return (%)")
    ax.set_title("Rolling 1-Year Return Comparison")
    ax.legend(fontsize=8); ax.grid(True)

    # 4: Correlation of monthly returns
    mo_s   = pf["returns"].resample("ME").apply(lambda x: (1+x).prod()-1)
    mo_bah = pf["bah_returns"].resample("ME").apply(lambda x: (1+x).prod()-1)
    mo_s   = mo_s.reindex(mo_bah.index).dropna()
    mo_bah = mo_bah.reindex(mo_s.index).dropna()

    ax = axes[1, 1]
    ax.scatter(mo_bah * 100, mo_s * 100,
               c=[C["win"] if v >= 0 else C["loss"] for v in mo_s],
               alpha=0.6, s=20)
    z = np.polyfit(mo_bah * 100, mo_s * 100, 1)
    xl = np.linspace(mo_bah.min()*100, mo_bah.max()*100, 100)
    ax.plot(xl, np.polyval(z, xl), color="white", lw=1.2, ls="--",
            label=f"β={z[0]:.2f}")
    ax.axhline(0, color=C["border"], lw=0.5, ls=":")
    ax.axvline(0, color=C["border"], lw=0.5, ls=":")
    corr = np.corrcoef(mo_bah, mo_s)[0, 1]
    ax.set_xlabel("SPY Monthly Return (%)"); ax.set_ylabel("Strategy Monthly Return (%)")
    ax.set_title(f"Monthly Return Correlation  ρ={corr:.2f}")
    ax.legend(fontsize=8); ax.grid(True)

    plt.tight_layout()
    _show(fig, "08_attribution.png")


