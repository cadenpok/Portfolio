def _risk_free(dates):
    rates = pd.Series(np.nan, index=dates)
    table = [
        ("1993-01-01","1994-02-01",0.030),("1994-02-01","1995-07-01",0.060),
        ("1995-07-01","1999-06-01",0.053),("1999-06-01","2001-01-01",0.065),
        ("2001-01-01","2003-07-01",0.020),("2003-07-01","2004-07-01",0.010),
        ("2004-07-01","2007-09-01",0.053),("2007-09-01","2009-01-01",0.020),
        ("2009-01-01","2015-12-01",0.002),("2015-12-01","2018-01-01",0.013),
        ("2018-01-01","2020-03-15",0.025),("2020-03-15","2022-03-15",0.001),
        ("2022-03-15","2023-08-01",0.050),("2023-08-01","2099-01-01",0.053),
    ]
    for s, e, r in table:
        rates.loc[(dates >= s) & (dates < e)] = r
    return rates.fillna(0.04)

def fetch_data(start="1993-01-29"):
    print("  Downloading SPY …")
    spy = yf.download("SPY",  start=start, auto_adjust=True, progress=False)
    print("  Downloading ^VIX …")
    vix = yf.download("^VIX", start=start, auto_adjust=True, progress=False)
    df = pd.DataFrame({
        "spy": spy["Close"].squeeze(),
        "vix": vix["Close"].squeeze(),
    }).dropna()
    df["rf"] = _risk_free(df.index)
    print(f"  {len(df):,} trading days  "
          f"({df.index[0].date()} → {df.index[-1].date()})\n")
    return df

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 2 — BLACK-SCHOLES + SKEW
# ─────────────────────────────────────────────────────────────────────────────
def _bs_put(S, K, T, r, sigma):
    if T < 1e-6 or sigma < 1e-6:
        return max(K - S, 0.0)
    d1 = (np.log(S/K) + (r + 0.5*sigma**2)*T) / (sigma*np.sqrt(T))
    d2 = d1 - sigma*np.sqrt(T)
    return float(max(K*np.exp(-r*T)*norm.cdf(-d2) - S*norm.cdf(-d1), 0.0))

def _skew_sigma(S, K, atm):
    lm = np.log(S/K)
    return atm * max(1 + SKEW_SLOPE*lm + SKEW_CONVEXITY*lm**2, 0.01)

def _price_spread(S, K_s, K_l, T, r, atm):
    """Price the put spread. Returns dict with all pricing detail."""
    sig_s = _skew_sigma(S, K_s, atm)
    sig_l = _skew_sigma(S, K_l, atm)
    p_s   = _bs_put(S, K_s, T, r, sig_s)
    p_l   = _bs_put(S, K_l, T, r, sig_l)
    prem  = p_s - p_l          # net credit per share (positive = credit received)
    width = K_s - K_l          # spread width per share
    return dict(
        premium   = prem,
        max_loss  = width - prem,   # worst-case loss per share (positive number)
        width     = width,
        p_short   = p_s,
        p_long    = p_l,
        sig_short = sig_s,
        sig_long  = sig_l,
    )

def _pnl_expiry(S_exp, K_s, K_l, prem):
    """
    Realised P&L per share at expiry.
    Full profit  (=+prem)          if S_exp >= K_s
    Full loss    (=-(width-prem))  if S_exp <= K_l
    Linear in between.
    """
    cost = max(K_s - S_exp, 0.0) - max(K_l - S_exp, 0.0)
    return prem - cost

def _mtm_pnl(S, K_s, K_l, T_rem, r, atm, entry_prem):
    """Mark-to-market P&L per share on an open spread (positive = unrealised gain)."""
    sp = _price_spread(S, K_s, K_l, T_rem, r, atm)
    return entry_prem - sp["premium"]   # debit to close vs credit received

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 3 — BACKTEST ENGINE
# ─────────────────────────────────────────────────────────────────────────────
def run_backtest(df: pd.DataFrame) -> tuple[pd.DataFrame, pd.DataFrame]:
    """
    Run the fixed-parameter put spread backtest.

    Returns
    -------
    trades    : one row per completed trade
    portfolio : daily portfolio timeseries
    """

    spy   = df["spy"].to_numpy(dtype=np.float64)
    vix   = df["vix"].to_numpy(dtype=np.float64)
    rf    = df["rf"].to_numpy(dtype=np.float64)
    dates = df.index
    n     = len(df)

    # Pre-build month → sorted list of row indices
    ym_idx: dict[tuple, list[int]] = {}
    for i, dt in enumerate(dates):
        ym_idx.setdefault((dt.year, dt.month), []).append(i)

    def nth_idx(yr, mo, nth):
        g = ym_idx.get((yr, mo), [])
        return g[nth - 1] if len(g) >= nth else None

    def expiry_idx(entry_i):
        target = dates[entry_i] + relativedelta(months=1)
        pos    = dates.searchsorted(target)
        return int(pos) if pos < n else None

    # ── State ────────────────────────────────────────────────────────────────
    spy_shares = INITIAL_SPY_VALUE / spy[0]
    cash       = INITIAL_CASH

    trades         = []
    active         = None
    months_opened  = set()
    sl_thresh      = STOP_LOSS_PCT / 100.0

    for i in range(n):
        S   = spy[i]
        v   = vix[i]
        r   = rf[i]
        dt  = dates[i]

        # ── A) Manage open trade ───────────────────────────────────────────
        if active:
            exp_i = active["exp_i"]

            # ── Expiry ────────────────────────────────────────────────────
            if i >= exp_i:
                pnl_ps    = _pnl_expiry(S, active["K_s"], active["K_l"], active["prem"])
                total_pnl = pnl_ps * CONTRACT_SIZE * active["n_contracts"]
                cash     += total_pnl

                active.update(
                    exit_date   = dt,
                    exit_spy    = S,
                    exit_reason = "expiry",
                    pnl_ps      = pnl_ps,
                    total_pnl   = total_pnl,
                    cash_after  = cash,
                    spy_value_exit = spy_shares * S,
                    total_value_exit = cash + spy_shares * S,
                )
                trades.append(active)
                active = None

            # ── Stop-loss check ───────────────────────────────────────────
            else:
                T_rem = max((dates[exp_i] - dt).days / 365.0, 1e-6)
                mtm   = _mtm_pnl(S, active["K_s"], active["K_l"],
                                  T_rem, r, v / 100.0, active["prem"])
                # mtm negative = losing money
                if -mtm >= sl_thresh * active["max_loss_ps"]:
                    total_pnl = mtm * CONTRACT_SIZE * active["n_contracts"]
                    cash     += total_pnl

                    active.update(
                        exit_date   = dt,
                        exit_spy    = S,
                        exit_reason = "stop_loss",
                        pnl_ps      = mtm,
                        total_pnl   = total_pnl,
                        cash_after  = cash,
                        spy_value_exit = spy_shares * S,
                        total_value_exit = cash + spy_shares * S,
                    )
                    trades.append(active)
                    active = None

        # ── B) Open new trade ─────────────────────────────────────────────
        ym = (dt.year, dt.month)
        if not active and ym not in months_opened:
            entry_i = nth_idx(dt.year, dt.month, TRADE_DAY)
            if entry_i == i:
                months_opened.add(ym)

                if v < MIN_VIX:
                    # VIX too low — skip month, record as skipped
                    trades.append(dict(
                        entry_date=dt, exit_date=None, exit_spy=None,
                        K_s=None, K_l=None, prem=None, max_loss_ps=None,
                        n_contracts=0, total_credit=0, buying_power=None,
                        vix_entry=v, spy_entry=S,
                        exit_reason="vix_filter", pnl_ps=0,
                        total_pnl=0, cash_after=cash,
                        spy_value_entry=spy_shares*S,
                        spy_value_exit=None,
                        total_value_entry=cash+spy_shares*S,
                        total_value_exit=None,
                        sig_short=None, sig_long=None, width=None,
                    ))
                    continue

                exp_i = expiry_idx(i)
                if exp_i is None:
                    continue

                K_s = S * (1 - SHORT_PUT_OTM / 100.0)
                K_l = S * (1 - LONG_PUT_OTM  / 100.0)
                T   = max((dates[exp_i] - dt).days / 365.0, 1e-6)
                sp  = _price_spread(S, K_s, K_l, T, r, v / 100.0)

                prem     = sp["premium"]
                max_loss = sp["max_loss"]   # per share, positive number

                if prem <= 0 or max_loss <= 0:
                    continue

                # ── Position sizing ───────────────────────────────────────
                spy_val     = spy_shares * S
                buy_power   = max(cash, 0.0) * CASH_MARGIN + spy_val * SECURITIES_MARGIN
                n_contracts = int(buy_power / (max_loss * CONTRACT_SIZE))

                if n_contracts <= 0:
                    continue

                active = dict(
                    entry_date   = dt,
                    exp_i        = exp_i,
                    expiry_date  = dates[exp_i],
                    spy_entry    = S,
                    vix_entry    = v,
                    K_s          = K_s,
                    K_l          = K_l,
                    prem         = prem,
                    max_loss_ps  = max_loss,
                    width        = sp["width"],
                    sig_short    = sp["sig_short"],
                    sig_long     = sp["sig_long"],
                    n_contracts  = n_contracts,
                    total_credit = prem * CONTRACT_SIZE * n_contracts,
                    buying_power = buy_power,
                    spy_value_entry   = spy_val,
                    total_value_entry = cash + spy_val,
                    cash_entry   = cash,
                    # filled at exit:
                    exit_date=None, exit_spy=None, exit_reason=None,
                    pnl_ps=None, total_pnl=None, cash_after=None,
                    spy_value_exit=None, total_value_exit=None,
                )

    # Force-close open trade at end of data
    if active:
        S_last = spy[-1]
        pnl_ps = _pnl_expiry(S_last, active["K_s"], active["K_l"], active["prem"])
        total_pnl = pnl_ps * CONTRACT_SIZE * active["n_contracts"]
        cash     += total_pnl
        active.update(
            exit_date="end_of_data", exit_spy=S_last,
            exit_reason="end_of_data", pnl_ps=pnl_ps,
            total_pnl=total_pnl, cash_after=cash,
            spy_value_exit=spy_shares * S_last,
            total_value_exit=cash + spy_shares * S_last,
        )
        trades.append(active)

    trades_df = pd.DataFrame(trades)

    # ── Build cash timeseries (daily, forward-filled from exit events) ────────
    pf = pd.DataFrame(index=dates)
    pf["spy_price"] = spy
    pf["spy_value"] = spy_shares * spy
    pf["vix"]       = vix

    cash_ts = np.empty(n); cash_ts[:] = np.nan; cash_ts[0] = INITIAL_CASH
    for t in trades_df[trades_df["cash_after"].notna()].itertuples():
        if hasattr(t, "exit_date") and t.exit_date is not None:
            if t.exit_date in df.index:
                cash_ts[df.index.get_loc(t.exit_date)] = t.cash_after

    valid = np.where(~np.isnan(cash_ts), np.arange(n), 0)
    np.maximum.accumulate(valid, out=valid)
    pf["cash"]        = cash_ts[valid]
    pf["total_value"] = pf["spy_value"] + pf["cash"]

    # ── PERFORMANCE is cash-only (options P&L only, not SPY appreciation) ────
    # Returns based purely on cash balance changes.
    pf["returns"]     = pf["cash"].pct_change().fillna(0)

    # SPY buy-and-hold normalised to INITIAL_CASH for comparison on same axis
    pf["bah_cash_equiv"] = (spy / spy[0]) * INITIAL_CASH
    pf["bah_returns"]    = pf["bah_cash_equiv"].pct_change().fillna(0)

    # ── Monthly resampled (one point per month — last trading day) ────────────
    pf_mo = pd.DataFrame()
    pf_mo["cash"]          = pf["cash"].resample("ME").last()
    pf_mo["spy_price"]     = pf["spy_price"].resample("ME").last()
    pf_mo["spy_value"]     = pf["spy_value"].resample("ME").last()
    pf_mo["total_value"]   = pf["total_value"].resample("ME").last()
    pf_mo["bah_cash_equiv"]= pf["bah_cash_equiv"].resample("ME").last()
    pf_mo["vix"]           = pf["vix"].resample("ME").last()
    pf_mo["cash_return"]   = pf_mo["cash"].pct_change().fillna(0)

    # Drawdown on monthly cash
    cash_arr = pf_mo["cash"].values
    peak     = np.maximum.accumulate(cash_arr)
    pf_mo["dd"]     = (cash_arr - peak) / peak * 100
    # SPY drawdown (same normalisation)
    bah_arr  = pf_mo["bah_cash_equiv"].values
    bah_peak = np.maximum.accumulate(bah_arr)
    pf_mo["dd_bah"] = (bah_arr - bah_peak) / bah_peak * 100

    # For rolling metrics use daily returns still (need enough points)
    cum_c = np.cumprod(1 + pf["returns"].values)
    pf["cum"] = cum_c
    peak_c    = np.maximum.accumulate(cum_c)
    pf["dd"]  = (cum_c - peak_c) / peak_c * 100

    cum_b = np.cumprod(1 + pf["bah_returns"].values)
    pf["dd_bah"] = (cum_b - np.maximum.accumulate(cum_b)) \
                   / np.maximum.accumulate(cum_b) * 100

    return trades_df, pf, pf_mo

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 4 — METRICS
# ─────────────────────────────────────────────────────────────────────────────
def compute_metrics(trades_df: pd.DataFrame, pf: pd.DataFrame, pf_mo: pd.DataFrame) -> dict:
    done = trades_df[trades_df["exit_reason"] != "vix_filter"].copy()
    done = done[done["total_pnl"].notna()]
    wins   = done[done["total_pnl"] >= 0]
    losses = done[done["total_pnl"] <  0]

    # All performance stats based on cash balance only
    ret     = pf["returns"]          # daily cash pct-change
    ann_ret = ret.mean() * 252
    ann_vol = ret.std()  * np.sqrt(252)
    sharpe  = ann_ret / ann_vol if ann_vol > 0 else 0
    neg     = ret[ret < 0]
    sortino = ann_ret / (neg.std() * np.sqrt(252)) if len(neg) > 1 else 0
    mdd     = pf_mo["dd"].min()
    calmar  = ann_ret / abs(mdd / 100) if mdd != 0 else 0

    years   = (pf.index[-1] - pf.index[0]).days / 365.25
    sv, fv  = pf["cash"].iloc[0], pf["cash"].iloc[-1]
    cagr    = (fv / sv) ** (1 / years) - 1 if years > 0 and sv > 0 else 0
    tot_ret = (fv - sv) / sv if sv > 0 else 0

    avg_w = wins["total_pnl"].mean()   if len(wins)   > 0 else 0
    avg_l = losses["total_pnl"].mean() if len(losses) > 0 else 0
    pf_r  = (avg_w * len(wins)) / abs(avg_l * len(losses)) \
            if avg_l != 0 and len(losses) > 0 else 0
    n_sl  = (done["exit_reason"] == "stop_loss").sum()

    return dict(
        cagr=cagr, total_return=tot_ret, annual_return=ann_ret,
        annual_vol=ann_vol, sharpe=sharpe, sortino=sortino,
        calmar=calmar, max_drawdown=mdd / 100,
        n_trades=len(done), n_wins=len(wins), n_losses=len(losses),
        win_rate=len(wins) / len(done) if len(done) > 0 else 0,
        avg_win=avg_w, avg_loss=avg_l, profit_factor=pf_r,
        n_stop_loss=int(n_sl), stop_loss_rate=n_sl / len(done) if len(done) > 0 else 0,
        total_pnl=done["total_pnl"].sum(),
        final_cash=fv, initial_cash=sv,
        years=years,
        vix_skipped=int((trades_df["exit_reason"] == "vix_filter").sum()),
    )

