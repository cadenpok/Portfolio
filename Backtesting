def _active(trades_df):
    return trades_df[
        (trades_df["exit_reason"] != "vix_filter") &
        trades_df["total_pnl"].notna()
    ].copy()

# ── Chart 01 — Master cash equity curve (monthly points) ─────────────────────
def chart_01_equity(pf, pf_mo, trades_df, m):
    done = _active(trades_df)
    wins = done[done["total_pnl"] >= 0]
    lsss = done[done["total_pnl"] <  0]

    fig, axes = plt.subplots(4, 1, figsize=(17, 22),
                              gridspec_kw={"height_ratios": [3, 1.2, 1.2, 1]})
    fig.suptitle(
        f"SPY Put Spread — Cash Balance Performance (Monthly)\n"
        f"Short {SHORT_PUT_OTM}% OTM | Long {LONG_PUT_OTM}% OTM | "
        f"Day {TRADE_DAY} | Min VIX {MIN_VIX} | Stop {STOP_LOSS_PCT}%",
        fontsize=13, fontweight="bold", y=1.002)

    # Panel 1: Cash balance — one point per month
    ax = axes[0]
    ax.plot(pf_mo.index, pf_mo["cash"], color=C["port"], lw=2.2,
            marker="o", markersize=3.5, label="Cash Balance (strategy P&L)")
    ax.plot(pf_mo.index, pf_mo["bah_cash_equiv"], color=C["spy"], lw=1.5,
            alpha=0.8, label=f"SPY return on ${INITIAL_CASH:,.0f} (reference)")
    ax.axhline(INITIAL_CASH, color=C["border"], lw=0.8, ls="--",
               label=f"Starting cash ${INITIAL_CASH:,.0f}")
    ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda v, _: f"${v:,.0f}"))
    ax.set_ylabel("Cash Balance ($)")
    ax.set_title(f"CAGR {m['cagr']:.2%}  |  Sharpe {m['sharpe']:.2f}  |  "
                 f"Max DD {m['max_drawdown']:.2%}  |  Win Rate {m['win_rate']:.2%}")
    ax.legend(fontsize=9, loc="upper left")
    ax.grid(True)
    ax2 = ax.twinx()
    ax2.fill_between(pf_mo.index, pf_mo["vix"], alpha=0.07, color=C["vix"])
