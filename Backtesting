# ── Chart 06 — Rolling metrics (monthly points) ───────────────────────────────
def chart_06_rolling(pf, pf_mo):
    ret = pf["returns"]   # daily, for rolling window width
    fig, axes = plt.subplots(4, 1, figsize=(16, 18), sharex=True)
    fig.suptitle("Rolling Performance Metrics — Cash Returns (Monthly)", fontsize=13, fontweight="bold")

    def mo(series):
        return series.resample("ME").last()

    configs = [
        ("Sharpe Ratio (252d)",
         mo(ret.rolling(252).apply(
             lambda x: x.mean()/x.std()*np.sqrt(252) if x.std()>0 else np.nan)),
         C["neutral"], True),
        ("Ann. Volatility % (252d)",
         mo(ret.rolling(252).std() * np.sqrt(252) * 100),
         C["gold"], False),
        ("Ann. Return % (252d)",
         mo(((1+ret).rolling(252).apply(np.prod)-1)*100),
         C["port"], True),
        ("Max DD in Window % (252d)",
         mo(ret.rolling(252).apply(
             lambda x: ((np.cumprod(1+x)/np.maximum.accumulate(np.cumprod(1+x)))-1).min()*100)),
         C["loss"], False),
    ]
    for ax, (label, series, color, signed) in zip(axes, configs):
        ax.plot(series.index, series.values, color=color, lw=1.8,
                marker="o", markersize=2.5)
        ax.axhline(0, color=C["border"], lw=0.7, ls="--")
        if signed:
            ax.fill_between(series.index, series, 0,
                            where=(series >= 0), color=color, alpha=0.2)
            ax.fill_between(series.index, series, 0,
                            where=(series <  0), color=C["loss"], alpha=0.2)
        else:
            ax.fill_between(series.index, series, alpha=0.15, color=color)
        ax.set_ylabel(label, fontsize=9); ax.grid(True)

    plt.tight_layout()
    _show(fig, "06_rolling_metrics.png")


# ── Chart 07 — Win/loss deep dive ─────────────────────────────────────────────
def chart_07_win_loss(trades_df):
    done = _active(trades_df).copy()
    # hold_d computed FIRST, before slicing
    done["hold_d"] = (pd.to_datetime(done["exit_date"]) -
                      pd.to_datetime(done["entry_date"])).dt.days.fillna(0).astype(int)
    wins = done[done["total_pnl"] >= 0]
    lsss = done[done["total_pnl"] <  0]

    streak = []; cur = 0
    for v in (done["total_pnl"] >= 0).values:
        cur = cur + 1 if v else cur - 1
        streak.append(cur)

    fig, axes = plt.subplots(2, 3, figsize=(20, 12))
    fig.suptitle("Win / Loss Deep Dive", fontsize=14, fontweight="bold")

    # 1: ECDF
    ax = axes[0, 0]
    for data, color, label in [(wins["total_pnl"], C["win"], "Wins"),
                                (lsss["total_pnl"], C["loss"], "Losses")]:
        s = np.sort(data.values); y = np.arange(1, len(s)+1)/len(s)
        ax.plot(s, y, color=color, lw=2, label=label)
    ax.axvline(0, color=C["border"], lw=0.8, ls="--")
    ax.set_xlabel("P&L ($)"); ax.set_title("ECDF of Trade P&L")
    ax.legend(fontsize=8); ax.grid(True)

    # 2: Hold duration vs P&L
    ax = axes[0, 1]
    ax.scatter(wins["hold_d"], wins["total_pnl"], color=C["win"],  alpha=0.5, s=22, label="Win")
    ax.scatter(lsss["hold_d"], lsss["total_pnl"], color=C["loss"], alpha=0.5, s=22, label="Loss")
    ax.axhline(0, color=C["border"], lw=0.7, ls="--")
    ax.set_xlabel("Hold Duration (days)"); ax.set_ylabel("P&L ($)")
    ax.set_title("Hold Duration vs P&L"); ax.legend(fontsize=8); ax.grid(True)

    # 3: By exit reason
    ax = axes[0, 2]
    by_r = done.groupby("exit_reason")["total_pnl"].agg(["sum","count","mean"])
    bars = ax.bar(by_r.index, by_r["sum"],
                  color=[C["win"] if v >= 0 else C["loss"] for v in by_r["sum"]], alpha=0.85)
    for bar, (_, row) in zip(bars, by_r.iterrows()):
        ax.text(bar.get_x() + bar.get_width()/2, bar.get_height(),
                f"n={int(row['count'])}\nμ=${row['mean']:,.0f}",
                ha="center", va="bottom", fontsize=8, color=C["text"])
    ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda v, _: f"${v:,.0f}"))
    ax.set_title("Total P&L by Exit Reason"); ax.grid(True, axis="y")

    # 4: Rolling 24-trade win rate
    ax = axes[1, 0]
    roll_wr = (done["total_pnl"] >= 0).rolling(24).mean() * 100
    ax.plot(done["entry_date"].values, roll_wr.values, color=C["neutral"], lw=1.8)
    ax.axhline(50, color=C["border"], lw=0.8, ls="--")
    ax.fill_between(done["entry_date"].values, roll_wr, 50,
                    where=(roll_wr >= 50), color=C["win"],  alpha=0.25)
    ax.fill_between(done["entry_date"].values, roll_wr, 50,
                    where=(roll_wr <  50), color=C["loss"], alpha=0.25)
    ax.set_ylabel("Win Rate (%)"); ax.set_title("Rolling 24-Trade Win Rate"); ax.grid(True)

    # 5: Streak
    ax = axes[1, 1]
    ax.bar(range(len(streak)), streak,
           color=[C["win"] if v > 0 else C["loss"] for v in streak], alpha=0.75)
    ax.axhline(0, color=C["border"], lw=0.5)
    ax.set_xlabel("Trade #"); ax.set_ylabel("Running Streak")
    ax.set_title("Win(+) / Loss(−) Streak"); ax.grid(True, axis="y")

    # 6: Annual P&L
    ax = axes[1, 2]
    done2 = done.copy()
    done2["year"] = pd.to_datetime(done2["entry_date"]).dt.year
    by_yr = done2.groupby("year")["total_pnl"].sum()
    ax.bar(by_yr.index, by_yr.values,
           color=[C["win"] if v >= 0 else C["loss"] for v in by_yr.values], alpha=0.85)
    ax.axhline(0, color=C["border"], lw=0.5)
    ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda v, _: f"${v:,.0f}"))
    ax.set_title("Annual P&L (Options Premium)"); ax.grid(True, axis="y")

    plt.tight_layout()
    _show(fig, "07_win_loss_deepdive.png")


# ── Chart 08 — Return attribution (monthly) ───────────────────────────────────
def chart_08_attribution(pf, pf_mo, trades_df):
    done = _active(trades_df).sort_values("entry_date")
    ret  = pf["returns"]

    strat_12m = (1 + ret).rolling(252).apply(np.prod) - 1
    bah_12m   = (1 + pf["bah_returns"]).rolling(252).apply(np.prod) - 1
    alpha     = strat_12m - bah_12m

    strat_12m_mo = strat_12m.resample("ME").last()
    bah_12m_mo   = bah_12m.resample("ME").last()
    alpha_mo     = alpha.resample("ME").last()

    fig, axes = plt.subplots(2, 2, figsize=(16, 11))
    fig.suptitle("Return Attribution (Monthly)", fontsize=13, fontweight="bold")

    # 1: Rolling 12M alpha (monthly)
    ax = axes[0, 0]
    ax.fill_between(alpha_mo.index, alpha_mo * 100, 0,
                    where=(alpha_mo >= 0), color=C["win"],  alpha=0.6, label="Outperform")
    ax.fill_between(alpha_mo.index, alpha_mo * 100, 0,
                    where=(alpha_mo < 0),  color=C["loss"], alpha=0.6, label="Underperform")
    ax.plot(alpha_mo.index, alpha_mo * 100, color=C["port"], lw=1.2)
    ax.axhline(0, color=C["border"], lw=0.6)
    ax.set_ylabel("Excess Return vs SPY (pp)")
    ax.set_title("Rolling 12-Month Alpha vs SPY (Cash basis)")
    ax.legend(fontsize=8); ax.grid(True)

    # 2: Cash gain vs SPY gain decomposition (monthly)
    ax = axes[0, 1]
    init_spy  = pf_mo["spy_value"].iloc[0]
    init_cash = INITIAL_CASH
    spy_gain  = pf_mo["spy_value"] - init_spy
    opt_gain  = pf_mo["cash"] - init_cash
    ax.stackplot(pf_mo.index,
                 [spy_gain.clip(lower=0), opt_gain.clip(lower=0)],
                 labels=["SPY Appreciation", "Options Premium"],
                 colors=[C["spy"], C["win"]], alpha=0.75)
    ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda v, _: f"${v:,.0f}"))
    ax.set_title("Gain Decomposition — SPY vs Options Cash")
    ax.legend(fontsize=8, loc="upper left"); ax.grid(True)

    # 3: 12M rolling return comparison (monthly)
    ax = axes[1, 0]
    ax.plot(strat_12m_mo.index, strat_12m_mo * 100, color=C["port"], lw=1.8,
            marker="o", markersize=2.5, label="Cash Returns")
    ax.plot(bah_12m_mo.index,   bah_12m_mo   * 100, color=C["spy"],  lw=1.4,
            alpha=0.75, marker="o", markersize=2.5, label="SPY B&H")
    ax.axhline(0, color=C["border"], lw=0.6, ls="--")
    ax.set_ylabel("Rolling 12M Return (%)")
    ax.set_title("Rolling 1-Year Cash Return vs SPY")
    ax.legend(fontsize=8); ax.grid(True)

    # 4: Monthly return scatter (cash vs SPY)
    mo_s   = pf["returns"].resample("ME").apply(lambda x: (1+x).prod()-1)
    mo_b   = pf["bah_returns"].resample("ME").apply(lambda x: (1+x).prod()-1)
    mo_s   = mo_s.reindex(mo_b.index).dropna()
    mo_b   = mo_b.reindex(mo_s.index).dropna()
    ax = axes[1, 1]
    ax.scatter(mo_b * 100, mo_s * 100,
               c=[C["win"] if v >= 0 else C["loss"] for v in mo_s],
               alpha=0.65, s=22)
    if len(mo_b) > 1:
        z  = np.polyfit(mo_b * 100, mo_s * 100, 1)
        xl = np.linspace(mo_b.min()*100, mo_b.max()*100, 100)
        ax.plot(xl, np.polyval(z, xl), color="white", lw=1.2, ls="--",
                label=f"β={z[0]:.2f}")
    ax.axhline(0, color=C["border"], lw=0.5, ls=":")
    ax.axvline(0, color=C["border"], lw=0.5, ls=":")
    corr = float(np.corrcoef(mo_b, mo_s)[0, 1]) if len(mo_b) > 1 else 0
    ax.set_xlabel("SPY Monthly Return (%)"); ax.set_ylabel("Cash Monthly Return (%)")
    ax.set_title(f"Monthly Return Correlation  ρ={corr:.2f}")
    ax.legend(fontsize=8); ax.grid(True)

    plt.tight_layout()
    _show(fig, "08_attribution.png")


